PORT=3004
MONGO_URI=mongodb://127.0.0.1:27017/erp
SESSION_SECRET=change-this-to-a-long-random-string

# Default admin (created automatically on first start if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SMTP for the "welcome employee" email. Leave SMTP_HOST empty to just
# print the email in the console instead of sending it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="ERP Admin <your-email@gmail.com>"
