<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>User Registration Form</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <h1>User Registration Form</h1>

    <% if (Object.keys(errors).length > 0) { %>
      <div class="alert alert-error">
        <strong>Please fix the following errors:</strong>
        <ul>
          <% Object.values(errors).forEach(function(msg) { %>
            <li><%= msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form action="/register" method="POST" enctype="multipart/form-data" novalidate>

      <!-- Username -->
      <div class="form-group">
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= old.username || '' %>"
          class="<%= errors.username ? 'input-error' : '' %>"
        />
        <% if (errors.username) { %><span class="field-error"><%= errors.username %></span><% } %>
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          class="<%= errors.password ? 'input-error' : '' %>"
        />
        <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
      </div>

      <!-- Confirm Password -->
      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          class="<%= errors.confirmPassword ? 'input-error' : '' %>"
        />
        <% if (errors.confirmPassword) { %><span class="field-error"><%= errors.confirmPassword %></span><% } %>
      </div>

      <!-- Email -->
      <div class="form-group">
        <label for="email">Email</label>
        <input
          type="text"
          id="email"
          name="email"
          value="<%= old.email || '' %>"
          class="<%= errors.email ? 'input-error' : '' %>"
        />
        <% if (errors.email) { %><span class="field-error"><%= errors.email %></span><% } %>
      </div>

      <!-- Gender (radio) -->
      <div class="form-group">
        <label>Gender</label>
        <div class="inline-options">
          <% genderOptions.forEach(function(g) { %>
            <label class="inline-label">
              <input
                type="radio"
                name="gender"
                value="<%= g %>"
                <%= old.gender === g ? 'checked' : '' %>
              />
              <%= g %>
            </label>
          <% }) %>
        </div>
        <% if (errors.gender) { %><span class="field-error"><%= errors.gender %></span><% } %>
      </div>

      <!-- Hobbies (checkboxes) -->
      <div class="form-group">
        <label>Hobbies</label>
        <div class="inline-options">
          <% hobbyOptions.forEach(function(h) { %>
            <label class="inline-label">
              <input
                type="checkbox"
                name="hobbies"
                value="<%= h %>"
                <%= (old.hobbies || []).includes(h) ? 'checked' : '' %>
              />
              <%= h %>
            </label>
          <% }) %>
        </div>
        <% if (errors.hobbies) { %><span class="field-error"><%= errors.hobbies %></span><% } %>
      </div>

      <!-- Profile Picture (single file) -->
      <div class="form-group">
        <label for="profilePic">Profile Picture (single image, max 2MB)</label>
        <input type="file" id="profilePic" name="profilePic" accept="image/*" />
        <% if (errors.profilePic) { %><span class="field-error"><%= errors.profilePic %></span><% } %>
      </div>

      <!-- Other Pictures (multiple files) -->
      <div class="form-group">
        <label for="otherPics">Other Pictures (up to 5 images, max 2MB each, optional)</label>
        <input type="file" id="otherPics" name="otherPics" accept="image/*" multiple />
      </div>

      <% if (errors.files) { %>
        <div class="field-error file-error"><%= errors.files %></div>
      <% } %>

      <button type="submit">Register</button>
    </form>
  </div>
</body>
</html>
